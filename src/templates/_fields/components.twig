{# ============================================================================
 # Bundle components field input
 # The product + quantity repeater rendered inside the native element editor.
 # Rows post as products[<index>][productId] / [qty]; the bundle's setProducts()
 # reads them back on save.
 # ========================================================================== #}

{% css %}
    .bundle-product-header,
    .bundle-product-row { display: flex; align-items: center; gap: 12px; }
    .bundle-product-header {
        font-weight: 600; color: var(--medium-text-color); font-size: 11px; text-transform: uppercase;
        letter-spacing: 0.5px; padding-bottom: 6px; border-bottom: 1px solid var(--hairline-color);
    }
    .bundle-product-row { padding: 10px 0; border-bottom: 1px solid var(--hairline-color); }
    .bundle-product-row:last-child { border-bottom: none; }
    .bundle-product-row.draghelper { background: var(--white); border: 1px solid var(--hairline-color); border-radius: var(--medium-border-radius); padding: 10px 12px; }
    .bundle-product-cell--handle { flex: 0 0 20px; text-align: center; cursor: move; }
    .bundle-product-cell--product { flex: 1 1 auto; min-width: 0; }
    .bundle-product-cell--product .elementselect { width: 100%; }
    .bundle-product-cell--qty { flex: 0 0 80px; }
    .bundle-product-cell--qty input { width: 100%; }
    .bundle-product-cell--delete { flex: 0 0 20px; text-align: center; }
    .bundle-products .btn.add { margin-top: 12px; }
{% endcss %}

<div id="bundle-products" class="bundle-products">
    <div class="bundle-product-header">
        <div class="bundle-product-cell bundle-product-cell--handle"></div>
        <div class="bundle-product-cell bundle-product-cell--product">{{ 'Product'|t('bundle-builder') }}</div>
        <div class="bundle-product-cell bundle-product-cell--qty">{{ 'Qty'|t('bundle-builder') }}</div>
        <div class="bundle-product-cell bundle-product-cell--delete"></div>
    </div>
    <div class="bundle-product-rows">
        {% for index, bundleProduct in bundle.getProducts() %}
            {{ include('bundle-builder/bundles/_product-row', { index: index, bundleProduct: bundleProduct }, with_context = false) }}
        {% endfor %}
    </div>
    {% if not static %}
        <button type="button" id="add-bundle-product" class="btn add icon">{{ 'Add a product'|t('bundle-builder') }}</button>
    {% endif %}
</div>

{% if not static %}
    {% js %}
    (function() {
        var index = {{ bundle.getProducts()|length }};
        var rows = document.querySelector('#bundle-products .bundle-product-rows');
        var addBtn = document.getElementById('add-bundle-product');

        if (rows) {
            var dragSort = new Garnish.DragSort($(rows).children('.bundle-product-row'), {
                handle: '.move.icon',
                axis: Garnish.Y_AXIS,
                container: rows,
            });
        }

        if (addBtn && rows) {
            addBtn.addEventListener('click', function() {
                Craft.sendActionRequest('POST', 'bundle-builder/bundles/product-row', { data: { index: index } })
                    .then(function(response) {
                        var tmp = document.createElement('div');
                        tmp.innerHTML = response.data.html.trim();
                        var newRow = tmp.firstElementChild;
                        rows.appendChild(newRow);
                        Craft.appendHeadHtml(response.data.headHtml);
                        Craft.appendBodyHtml(response.data.bodyHtml);
                        if (dragSort) {
                            dragSort.addItems($(newRow));
                        }
                        index++;
                    });
            });

            rows.addEventListener('click', function(e) {
                if (e.target.classList.contains('bundle-product-remove')) {
                    var row = e.target.closest('.bundle-product-row');
                    if (row) {
                        if (dragSort) {
                            dragSort.removeItems($(row));
                        }
                        row.parentNode.removeChild(row);
                    }
                }
            });
        }
    })();
    {% endjs %}
{% endif %}
