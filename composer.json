{
  "name": "johnhenry/craft-bundle-builder",
  "description": "Product bundles for Craft Commerce: one cart line at one price, with the customer choosing each part's variant and stock taken off each part.",
  "type": "craft-plugin",
  "version": "1.2.0",
  "keywords": [
    "craft-commerce",
    "product bundles",
    "bundle products",
    "bundle builder",
    "kits",
    "hampers",
    "gift boxes",
    "variant selection",
    "bundle pricing",
    "bundle discounts",
    "bundle inventory",
    "bundle vat"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "John Henry",
      "homepage": "https://johnhenry.ie"
    }
  ],
  "homepage": "https://johnhenry.ie/plugins/bundle-builder/",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "craftcms/cms": "^5.0",
    "craftcms/commerce": "^5.3"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.2",
    "verbb/hyper": "^2.0 || ^3.0",
    "verbb/navigation": "^3.0 || ^4.0"
  },
  "suggest": {
    "verbb/hyper": "Adds a Bundle link type to Hyper link fields, so links can point at a bundle.",
    "verbb/navigation": "Lets bundles be added as nodes in Navigation menus out of the box."
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "johnhenry\\bundlebuilder\\": "src/"
    }
  },
  "scripts": {
    "phpstan": "phpstan --ansi --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "support": {
    "docs": "https://johnhenry.ie/plugins/bundle-builder/",
    "source": "https://github.com/john-henry/craft-bundle-builder",
    "issues": "https://github.com/john-henry/craft-bundle-builder/issues"
  },
  "extra": {
    "name": "Bundle Builder",
    "handle": "bundle-builder",
    "developer": "John Henry",
    "developerUrl": "https://johnhenry.ie",
    "documentationUrl": "https://johnhenry.ie/plugins/bundle-builder/",
    "changelogUrl": "https://github.com/john-henry/craft-bundle-builder/blob/craft-5/CHANGELOG.md",
    "class": "johnhenry\\bundlebuilder\\BundleBuilder"
  }
}
