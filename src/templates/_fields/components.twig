<div id="bundle-products" class="bundle-products">
    <div class="bundle-product-header">
        <div class="bundle-product-cell bundle-product-cell--handle"></div>
        <div class="bundle-product-cell bundle-product-cell--product">{{ 'Product'|t('bundle-builder') }}</div>
        <div class="bundle-product-cell bundle-product-cell--qty">{{ 'Qty'|t('bundle-builder') }}</div>
        <div class="bundle-product-cell bundle-product-cell--delete"></div>
    </div>
    {% if not static %}
        {{ hiddenInput('products', '') }}
    {% endif %}
    <div class="bundle-product-rows">
        {% set productIds = bundle.getProducts()|map(p => p.productId) %}
        {% set componentSources = bundle.typeId ? bundle.getType().componentSources : '*' %}
        {% for index, bundleProduct in bundle.getProducts() %}
            {{ include('bundle-builder/bundles/_product-row', {
                index: index,
                bundleProduct: bundleProduct,
                disabledProductIds: productIds|filter(id => id != bundleProduct.productId)|values,
                componentSources: componentSources,
            }, with_context = false) }}
        {% endfor %}
    </div>
    {% if not static %}
        <button type="button" class="btn add icon bundle-products-add">{{ 'Add a product'|t('bundle-builder') }}</button>
    {% endif %}
</div>
